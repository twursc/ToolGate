    "@types/express-serve-static-core": "4.19.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.10",
