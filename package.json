{
  "name": "mcai-mcp-gateway",
  "version": "0.1.0",
  "description": "MCP Gateway Service with authentication, request logging, and usage-based billing",
  "private": true,
  "type": "module",
  "bin": {
    "mcai-mcp-gateway": "./build/index.js"
  },
